---
// Page shell: head/meta, fonts, skip-link, footer.
// Page composition (nav choice, main content) belongs to the pages.
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { absoluteUrl, serializeJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  /** Page name for `{page} · Launch Start`; omit on home for the tagline form. */
  page?: string;
  description?: string;
  /** JSON-LD payloads to embed, one script per object. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  /** Posts and log entries emit `og:type: article`; everything else stays `website`. */
  ogType?: 'website' | 'article';
  /** Error and utility pages can opt out of indexing and canonical metadata. */
  noindex?: boolean;
}

const {
  page,
  description = site.description,
  jsonLd = [],
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const title = page
  ? page === site.title || page.endsWith(` · ${site.title}`)
    ? page
    : `${page} · ${site.title}`
  : `${site.title} — ${site.tagline}`;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImageUrl = absoluteUrl(ogImage ?? '/og-default.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- browser chrome matches the page ground; both hexes mirror --cream in tokens.css -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf5ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17130e" />
    <script is:inline>
      // Apply the stored theme choice before first paint so pages never flash
      // the wrong palette. No stored choice (or an unknown one) means the OS
      // preference rules. Each hex mirrors the theme's --cream in tokens.css.
      try {
        const grounds = {
          light: '#fbf5ea',
          spring: '#f0f8e6',
          summer: '#fdf4d3',
          autumn: '#fbeedd',
          winter: '#eef6fe',
          dark: '#17130e',
        };
        const theme = localStorage.getItem('theme');
        if (theme && grounds[theme]) {
          document.documentElement.dataset.theme = theme;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.setAttribute('content', grounds[theme]);
          }
        }
      } catch {
        // storage can be unavailable (private mode); the OS preference still applies
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${site.title} preview`} />
    <meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${site.title} preview`} />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd.map((ld) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(ld)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link mono" href="#main">Skip to content</a>
    <div class="sheet">
      <slot />
      <Footer />
    </div>
  </body>
</html>
